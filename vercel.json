{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/login",
            "destination": "/index.html"
        },
        {
            "source": "/registro",
            "destination": "/index.html"
        },
        {
            "source": "/tareas",
            "destination": "/index.html"
        }
    ]
}